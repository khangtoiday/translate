// ==UserScript==
// @name         Auto Translate On Selection (VI)
// @namespace    http://tampermonkey.net/
// @version      1.0
// @description  Bôi đen văn bản để tự động dịch sang tiếng Việt
// @author       You
// @match        *://*/*
// @grant        GM_xmlhttpRequest
// @connect      translate.googleapis.com
// @run-at       document-idle
// ==/UserScript==

(function () {
  'use strict';

  const BOX_ID = 'auto-tr-popup-box';
  let debounceTimer = null;

  // ---------- Style ----------
  const style = document.createElement('style');
  style.textContent = `
    #${BOX_ID} {
      position: absolute;
      z-index: 2147483647;
      max-width: 340px;
      background: #1e1e1e;
      color: #f2f2f2;
      font-size: 14px;
      line-height: 1.5;
      padding: 10px 12px;
      border-radius: 8px;
      box-shadow: 0 6px 20px rgba(0,0,0,0.35);
      font-family: -apple-system, "Segoe UI", Roboto, Arial, sans-serif;
      border: 1px solid #3a3a3a;
      pointer-events: auto;
      opacity: 0;
      transform: translateY(4px);
      transition: opacity .12s ease, transform .12s ease;
    }
    #${BOX_ID}.show {
      opacity: 1;
      transform: translateY(0);
    }
    #${BOX_ID} .tr-loading {
      color: #9aa0a6;
      font-style: italic;
    }
    #${BOX_ID} .tr-original {
      color: #9aa0a6;
      font-size: 12px;
      margin-bottom: 4px;
      border-bottom: 1px solid #3a3a3a;
      padding-bottom: 4px;
      max-height: 60px;
      overflow: hidden;
    }
    #${BOX_ID} .tr-close {
      position: absolute;
      top: 4px;
      right: 6px;
      cursor: pointer;
      color: #888;
      font-size: 13px;
      line-height: 1;
      user-select: none;
    }
    #${BOX_ID} .tr-close:hover {
      color: #fff;
    }
  `;
  document.head.appendChild(style);

  // ---------- Popup helpers ----------
  function removeBox() {
    const el = document.getElementById(BOX_ID);
    if (el) el.remove();
  }

  function createBox(x, y, originalText) {
    removeBox();
    const box = document.createElement('div');
    box.id = BOX_ID;
    box.style.left = `${x}px`;
    box.style.top = `${y}px`;
    box.innerHTML = `
      <span class="tr-close">✕</span>
      <div class="tr-original">${escapeHtml(truncate(originalText, 120))}</div>
      <div class="tr-loading">Đang dịch...</div>
    `;
    document.body.appendChild(box);
    requestAnimationFrame(() => box.classList.add('show'));

    box.querySelector('.tr-close').addEventListener('click', removeBox);

    // Prevent selection change inside the box from closing it
    box.addEventListener('mousedown', (e) => e.stopPropagation());

    return box;
  }

  function escapeHtml(str) {
    const div = document.createElement('div');
    div.textContent = str;
    return div.innerHTML;
  }

  function truncate(str, n) {
    return str.length > n ? str.slice(0, n) + '…' : str;
  }

  // ---------- Translation ----------
  function translateText(text, callback) {
    const url =
      'https://translate.googleapis.com/translate_a/single?client=gtx&sl=auto&tl=vi&dt=t&q=' +
      encodeURIComponent(text);

    GM_xmlhttpRequest({
      method: 'GET',
      url,
      onload: function (res) {
        try {
          const data = JSON.parse(res.responseText);
          const translated = data[0].map((chunk) => chunk[0]).join('');
          callback(null, translated);
        } catch (e) {
          callback(e);
        }
      },
      onerror: function (err) {
        callback(err);
      },
    });
  }

  // ---------- Position helper ----------
  function getSelectionPosition() {
    const sel = window.getSelection();
    if (!sel.rangeCount) return null;
    const range = sel.getRangeAt(0);
    const rect = range.getBoundingClientRect();
    if (!rect || (rect.width === 0 && rect.height === 0)) return null;

    return {
      x: rect.left + window.scrollX,
      y: rect.bottom + window.scrollY + 8,
    };
  }

  // ---------- Main handler ----------
  document.addEventListener('mouseup', (e) => {
    // Ignore clicks inside our own popup
    if (e.target.closest && e.target.closest(`#${BOX_ID}`)) return;

    clearTimeout(debounceTimer);
    debounceTimer = setTimeout(() => {
      const sel = window.getSelection();
      const text = sel.toString().trim();

      if (!text || text.length < 1) {
        removeBox();
        return;
      }

      const pos = getSelectionPosition();
      if (!pos) return;

      const box = createBox(pos.x, pos.y, text);

      translateText(text, (err, translated) => {
        const current = document.getElementById(BOX_ID);
        if (!current) return; // box was closed already
        const loadingEl = current.querySelector('.tr-loading');
        if (err) {
          loadingEl.textContent = 'Lỗi khi dịch. Thử lại.';
          loadingEl.classList.remove('tr-loading');
        } else {
          loadingEl.outerHTML = `<div>${escapeHtml(translated)}</div>`;
        }
      });
    }, 80); // debounce nhẹ để tránh gọi API liên tục khi kéo chọn
  });

  // Đóng popup khi click ra ngoài hoặc khi selection bị xóa
  document.addEventListener('mousedown', (e) => {
    if (e.target.closest && e.target.closest(`#${BOX_ID}`)) return;
    removeBox();
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape') removeBox();
  });
})();
